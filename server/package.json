{
  "name": "asi-quiz-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"import('fs').then(fs => { fs.copyFileSync('src/questions.json', 'dist/questions.json'); console.log('✅ questions.json copied to dist/'); })\"",
    "start": "node dist/server.js",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
