# ============================================================
# ASI Quiz Arena — Client Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# For Vercel production, set these in:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
# ============================================================

# Railway backend Socket.IO server URL
# Example: https://quiz-production-abc123.up.railway.app
# Leave EMPTY for local development (Vite proxy handles it automatically)
VITE_SOCKET_URL=
